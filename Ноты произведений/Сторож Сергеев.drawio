        <mxCell id="HROpFMuAQrBz1x04zCcz-7" value="&lt;pre class=&quot;field__podbor_new podbor__text&quot; style=&quot;font-family: &amp;quot;Roboto Mono&amp;quot;, &amp;quot;Courier New&amp;quot;, monospace; font-size: 19px; margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px; clear: both; white-space: pre; line-height: 1.4em; color: rgb(68, 68, 68); font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;b&gt;&lt;div class=&quot;podbor__chord&quot; data-chord=&quot;C&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;C&lt;/span&gt;&lt;/div&gt;        &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;Dm&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;Dm&lt;/span&gt;&lt;/div&gt;       &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;G&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;G&lt;/span&gt;&lt;/div&gt;       &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;C&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;C&lt;br&gt;&lt;/span&gt;&lt;/div&gt;Зеленая лампа, и грязный стол, и правила над столом,&lt;br&gt; &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;C&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;C&lt;/span&gt;&lt;/div&gt;        &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;Dm&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;Dm&lt;/span&gt;&lt;/div&gt;       &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;G7&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;G7&lt;/span&gt;&lt;/div&gt;     &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;C&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;C&lt;/span&gt;&lt;/div&gt; &lt;br&gt;Сторож Сергеев глядит в стакан и думает о былом.&lt;br&gt;  &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;Am&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;Am&lt;/span&gt;&lt;/div&gt;        &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;Em&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;Em&lt;/span&gt;&lt;/div&gt;       &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;Dm&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;Dm&lt;/span&gt;&lt;/div&gt;       &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;G&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;G&lt;/span&gt;&lt;/div&gt; &lt;br&gt;Но вот приходят к нему друзья, прервав его мыслей ход,&lt;br&gt;  &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;C&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;C&lt;/span&gt;&lt;/div&gt;         &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;Dm&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;Dm&lt;/span&gt;&lt;/div&gt;     &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;G&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;G&lt;/span&gt;&lt;/div&gt;       &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;C&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;C&lt;/span&gt;&lt;/div&gt; &lt;br&gt;И быстро вливают портвейна литр сторожу прямо в рот.&lt;br&gt;&lt;br&gt;  &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;C&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;C&lt;/span&gt;&lt;/div&gt;        &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;Dm&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;Dm&lt;/span&gt;&lt;/div&gt;       &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;G&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;G&lt;/span&gt;&lt;/div&gt;       &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;C&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;C&lt;/span&gt;&lt;/div&gt; &lt;br&gt;Друзья пришли к нему неспроста пройдя не одну версту.&lt;br&gt; &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;C&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;C&lt;/span&gt;&lt;/div&gt;        &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;Dm&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;Dm&lt;/span&gt;&lt;/div&gt;       &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;G7&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;G7&lt;/span&gt;&lt;/div&gt;     &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;C&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;C&lt;/span&gt;&lt;/div&gt; &lt;br&gt;Они желают видеть его на боевом посту.&lt;br&gt;  &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;Am&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;Am&lt;/span&gt;&lt;/div&gt;        &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;Em&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;Em&lt;/span&gt;&lt;/div&gt;       &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;Dm&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;Dm&lt;/span&gt;&lt;/div&gt;       &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;G&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;G&lt;/span&gt;&lt;/div&gt; &lt;br&gt;И сторож Сергеев, презрев свой долг, ловит беседы нить.&lt;br&gt;  &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;C&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;C&lt;/span&gt;&lt;/div&gt;        &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;Dm&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;Dm&lt;/span&gt;&lt;/div&gt;       &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;G&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;G&lt;/span&gt;&lt;/div&gt;       &lt;div class=&quot;podbor__chord&quot; data-chord=&quot;C&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; font-style: normal; vertical-align: baseline; outline: 0px; color: rgb(68, 68, 68); display: inline;&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: normal; vertical-align: baseline; outline: 0px;&quot;&gt;C&lt;/span&gt;&lt;/div&gt; &lt;br&gt;И ставит стулья друзьям своим, поскольку им негде пить.&lt;br&gt;&lt;br&gt;&lt;/b&gt;&lt;pre style=&quot;font-family: &amp;quot;Roboto Mono&amp;quot;, &amp;quot;Courier New&amp;quot;, monospace; margin-top: 0px; margin-bottom: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px; clear: both; line-height: 1.4em;&quot; class=&quot;field__podbor_new podbor__text&quot;&gt;&lt;b&gt;  &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;C&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;C&lt;/span&gt;&lt;/div&gt;        &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;Dm&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;Dm&lt;/span&gt;&lt;/div&gt;       &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;G&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;G&lt;/span&gt;&lt;/div&gt;       &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;C&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;C&lt;/span&gt;&lt;/div&gt; &lt;br&gt;И он говорит с ними до утра, забыв обойти свой двор.&lt;br&gt; &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;C&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;C&lt;/span&gt;&lt;/div&gt;        &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;Dm&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;Dm&lt;/span&gt;&lt;/div&gt;       &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;G7&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;G7&lt;/span&gt;&lt;/div&gt;     &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;C&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;C&lt;/span&gt;&lt;/div&gt; &lt;br&gt;Он пьет, не глядя совсем на дверь, куда мог забраться вор.&lt;br&gt;  &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;Am&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;Am&lt;/span&gt;&lt;/div&gt;        &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;Em&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;Em&lt;/span&gt;&lt;/div&gt;       &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;Dm&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;Dm&lt;/span&gt;&lt;/div&gt;       &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;G&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;G&lt;/span&gt;&lt;/div&gt; &lt;br&gt;Но ночь проходит, приходит день, как в мире заведено.&lt;br&gt;  &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;C&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;C&lt;/span&gt;&lt;/div&gt;        &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;Dm&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;Dm&lt;/span&gt;&lt;/div&gt;       &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;G&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;G&lt;/span&gt;&lt;/div&gt;       &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;C&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;C&lt;/span&gt;&lt;/div&gt; &lt;br&gt;И сторож Сергеев упал под дверь, допив до конца вино.&lt;br&gt;&lt;br&gt;  &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;C&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;C&lt;/span&gt;&lt;/div&gt;        &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;Dm&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;Dm&lt;/span&gt;&lt;/div&gt;       &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;G&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;G&lt;/span&gt;&lt;/div&gt;       &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;C&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;C&lt;/span&gt;&lt;/div&gt; &lt;br&gt;Зеленая лампа горит чуть-чуть, сменщик уж час как здесь,&lt;br&gt; &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;C&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;C&lt;/span&gt;&lt;/div&gt;        &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;Dm&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;Dm&lt;/span&gt;&lt;/div&gt;       &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;G7&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;G7&lt;/span&gt;&lt;/div&gt;     &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;C&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;C&lt;/span&gt;&lt;/div&gt; &lt;br&gt;А сторож Сергеев едва встает, синий с похмелья весь.&lt;br&gt;  &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;Am&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;Am&lt;/span&gt;&lt;/div&gt;        &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;Em&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;Em&lt;/span&gt;&lt;/div&gt;       &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;Dm&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;Dm&lt;/span&gt;&lt;/div&gt;       &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;G&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;G&lt;/span&gt;&lt;/div&gt; &lt;br&gt;И он, трясясь, выходит за дверь, не зная еще куда,&lt;br&gt;  &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;C&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;C&lt;/span&gt;&lt;/div&gt;        &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;Dm&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;Dm&lt;/span&gt;&lt;/div&gt;       &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;G&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;G&lt;/span&gt;&lt;/div&gt;       &lt;div style=&quot;margin: 0px; padding: 0px; border: 0px; font-size: 1em; vertical-align: baseline; outline: 0px; display: inline;&quot; class=&quot;podbor__chord&quot; data-chord=&quot;C&quot;&gt;&lt;span style=&quot;margin: 0px; padding: 0px; border: 0px; vertical-align: baseline; outline: 0px;&quot;&gt;C&lt;/span&gt;&lt;/div&gt; &lt;br&gt;Желая пива и лечь поспать, скромный герой труда.&lt;/b&gt;&lt;/pre&gt;&lt;/pre&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
